{
  "name": "wenzhou-harmonyos",
  "version": "0.9.9-7",
  "harmonyVersion": "0.9.9.7",
  "private": true,
  "description": "文舟 Vela：HarmonyOS NEXT / Android / Windows 开源小说创作与阅读工具",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:android": "node scripts/build-android.mjs",
    "test:android": "node tests/android-browser.mjs",
    "test:android:native": "node scripts/test-android-native.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs vendor/acode-writer/tests/*.test.cjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:ui": "node tests/browser.mjs && node tests/features-browser.mjs && node tests/workspace-browser.mjs && node tests/file-manager-browser.mjs && node tests/sidebars-browser.mjs && node tests/studio-browser.mjs",
    "test:reading": "node tests/reading-browser.mjs && node tests/reading-config-browser.mjs && node tests/double-reading-browser.mjs",
    "test:tex": "node tests/tex-browser.mjs",
    "test:ui:platforms": "node tests/ui-overhaul-browser.mjs",
    "test:glossary": "node tests/glossary-browser.mjs",
    "build:windows": "node scripts/build-windows.mjs",
    "test:windows": "node tests/windows-browser.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:lite": "node scripts/verify.mjs --lite --tex",
    "verify:release": "node scripts/verify.mjs --tex --windows",
    "build:lite": "node scripts/build.mjs --lite",
    "check:rawfile": "node scripts/check-rawfile.mjs",
    "build:android:lite": "node scripts/build-android.mjs --release --lite",
    "build:windows:lite": "node scripts/build-windows.mjs --lite",
    "test:vodt": "node tests/velaodt-browser.mjs",
    "package:ebook": "node scripts/package-ebook-component.mjs",
    "test:components": "node tests/components-browser.mjs",
    "test:start": "node tests/start-page-browser.mjs",
    "test:downloads": "node tests/component-download-browser.mjs",
    "test:latex": "node tests/latex-studio-browser.mjs",
    "test:grid:stress": "node tests/hex-grid-performance-browser.mjs",
    "test:planning:stress": "node tests/planning-multitab-performance-browser.mjs",
    "package:ebook-studio": "node scripts/package-ebook-studio.mjs",
    "build:ebook-mobi": "node scripts/build-ebook-mobi.mjs",
    "test:ebook-studio": "node tests/ebook-studio-browser.mjs && node tests/ebook-studio-visual-browser.mjs",
    "check:core": "node scripts/check-core.mjs",
    "typecheck:core": "tsc -p jsconfig.core.json",
    "lint:core": "eslint web/app-core tests/app-core*.mjs eslint.config.mjs --max-warnings 0 scripts/check-core.mjs",
    "format:core": "prettier --write \"web/app-core/**/*.mjs\" \"tests/app-core*.mjs\" eslint.config.mjs scripts/check-core.mjs jsconfig.core.json .prettierrc.json docs/adr/*.md",
    "format:core:check": "prettier --check \"web/app-core/**/*.mjs\" \"tests/app-core*.mjs\" eslint.config.mjs scripts/check-core.mjs jsconfig.core.json .prettierrc.json docs/adr/*.md",
    "test:gitea": "node --test tests/gitea.test.mjs && node tests/gitea-browser.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@lezer/highlight": "1.2.5",
    "dompurify": "^3.2.6",
    "fflate": "^0.8.3",
    "katex": "^0.19.0",
    "markdown-it": "^14.1.0",
    "pdfjs-dist": "4.10.38",
    "wasmtex": "^0.1.1"
  },
  "devDependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "epub-gen-memory": "1.1.2",
    "esbuild": "^0.25.0",
    "eslint": "10.13.0",
    "pagedjs": "0.4.3",
    "playwright": "^1.55.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
